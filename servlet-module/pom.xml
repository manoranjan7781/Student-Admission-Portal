<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build for the Servlet/JSP module.
  Target: Java 17 + Apache Tomcat 10.1 (Jakarta Servlet 6.0 -> package names start with "jakarta.").
  Build:  mvn clean package      ->  target/student-portal.war
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.studentportal</groupId>
  <artifactId>student-portal</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>
  <name>Student Admission Portal - Servlet Module</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <failOnMissingWebXml>true</failOnMissingWebXml>
  </properties>

  <dependencies>
    <!-- Servlet + JSP APIs: PROVIDED = Tomcat already contains them, so they must NOT be packed into the WAR -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.0.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet.jsp</groupId>
      <artifactId>jakarta.servlet.jsp-api</artifactId>
      <version>3.1.1</version>
      <scope>provided</scope>
    </dependency>

    <!-- MySQL JDBC driver: needed at runtime only (loaded by name in DatabaseUtil) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
      <scope>runtime</scope>
    </dependency>

    <!-- jBCrypt: verifies the bcrypt hashes created by PHP's password_hash() -->
    <dependency>
      <groupId>org.mindrot</groupId>
      <artifactId>jbcrypt</artifactId>
      <version>0.4</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>student-portal</finalName>   <!-- URL becomes http://localhost:8080/student-portal/ -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
      </plugin>
    </plugins>
  </build>
</project>
